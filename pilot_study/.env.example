# Coinglass API key (required for liquidation data)
# Sign up at https://www.coinglass.com/pricing — hobbyist tier ($29/month) is sufficient
COINGLASS_API_KEY=your_key_here

# Deribit API credentials (optional — public endpoints used by default)
# Only needed if rate-limited on public endpoints
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
